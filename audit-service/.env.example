PORT=4000
MONGO_URI=mongodb://audit_user:audit_password@127.0.0.1:27017/audit_service?authSource=admin

# Shared HMAC-SHA256 secret. Must match AUDIT_SIGNING_SECRET in api-laravel/.env
AUDIT_SIGNING_SECRET=

# Comma-separated origins allowed to call GET /events from the browser
CORS_ORIGINS=http://localhost:5173
