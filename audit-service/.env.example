PORT=4000
MONGO_URI=mongodb://audit_user:audit_password@127.0.0.1:27017/audit_service?authSource=admin

# Shared HMAC-SHA256 secret. Must match AUDIT_SIGNING_SECRET in api-laravel/.env
AUDIT_SIGNING_SECRET=

# API key for GET /events. Must match AUDIT_READ_API_KEY in api-laravel/.env
# (the dashboard reads the audit trail through a Laravel proxy endpoint).
AUDIT_READ_API_KEY=

# Used by the test suite only (a separate database that tests may wipe)
MONGO_TEST_URI=mongodb://audit_user:audit_password@127.0.0.1:27017/audit_service_test?authSource=admin
